# Sorabbyngo AI OS — required boot drivers (must be built-in)
CONFIG_SCSI=y
CONFIG_ATA=y
CONFIG_LIBATA=y
CONFIG_BLK_DEV_SD=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_EXT4_FS=y

# Sorabbyngo custom drivers
CONFIG_SORABBYNGO_NODEID=y
CONFIG_BYNGONET_IDENTITY=m
CONFIG_NET=y
CONFIG_INET=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_HASH2=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
