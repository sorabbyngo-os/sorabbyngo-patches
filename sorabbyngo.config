# SORABBYNGO AI OS — Kernel configuration overlay
# Apply with: ./scripts/kconfig/merge_config.sh .config sorabbyngo.config
#
# Base: Linux 6.19.10 | Arch: x86_64/ARM64/RISC-V | GCC 12

# ── Required boot drivers (built-in) ──────────────────────────────────
CONFIG_SCSI=y
CONFIG_ATA=y
CONFIG_LIBATA=y
CONFIG_BLK_DEV_SD=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_EXT4_FS=y

# ── Sorabbyngo custom drivers ─────────────────────────────────────────
CONFIG_SORABBYNGO_NODEID=y
CONFIG_BYNGONET_IDENTITY=m

# ── OpenBSD-inspired security hardening ──────────────────────────────
CONFIG_SORABBYNGO_WX_STRICT=y
CONFIG_SORABBYNGO_PLEDGE=y
CONFIG_SORABBYNGO_UNVEIL=y
CONFIG_SORABBYNGO_SLAB_GUARD=y
CONFIG_SORABBYNGO_SLAB_GUARD_INTERVAL=64
CONFIG_SORABBYNGO_NET_POLICY=y
CONFIG_SORABBYNGO_ANTISPOOF=y
CONFIG_SORABBYNGO_TCP_HARDENING=y
CONFIG_SORABBYNGO_PER_TASK_CANARY=y
CONFIG_SORABBYNGO_KASLR_ENTROPY=y

# ── Required for security features above ─────────────────────────────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_RODATA=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_IP_NF_FILTER=y
CONFIG_SIPHASH=y

# ── General kernel hardening (independent of OpenBSD patches) ─────────
CONFIG_CC_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_PAGE_POISONING=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=n
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_GCC_PLUGIN_STRUCTLEAK=y
CONFIG_GCC_PLUGIN_STRUCTLEAK_BYREF_ALL=y
CONFIG_GCC_PLUGIN_RANDSTRUCT=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_LOCK_DOWN_KERNEL=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y

# ── Stability: PREEMPT_RT for medical/clinical surfaces ───────────────
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y

# ── Disable attack surface ────────────────────────────────────────────
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_BINFMT_MISC=n
CONFIG_LEGACY_PTYS=n
CONFIG_DEVKMEM=n
CONFIG_PROC_KCORE=n
CONFIG_USERFAULTFD=n
CONFIG_MODIFY_LDT_SYSCALL=n
CONFIG_IA32_EMULATION=n
