menu "Byngonet Network Identity"

config BYNGONET_IDENTITY
	tristate "Byngonet network identity layer v0.3"
	depends on NETFILTER
	depends on NETFILTER_XTABLES
	select SORABBYNGO_NODEID
	default m
	help
	  Sorabbyngo mesh network identity layer. Provides:
	    - NodeID-verified peer allowlist via /proc/byngonet_peers
	    - Netfilter hook on UDP port 7422 (AISP protocol)
	    - Packet marking: verified peers tagged nfmark=0xBE00
	    - Statistics at /proc/byngonet_stats

	  Uses sorabbyngo_get_nodeid() accessor (read-only after init).
	  MODULE_SOFTDEP enforces load order after sorabbyngo_nodeid.

	  If unsure, say M.

endmenu
