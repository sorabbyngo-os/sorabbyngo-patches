diff --git a/security/sorabbyngo/sorabbyngo_lsm.h b/security/sorabbyngo/sorabbyngo_lsm.h
new file mode 100644
index 0000000..ccc0003
--- /dev/null
+++ b/security/sorabbyngo/sorabbyngo_lsm.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _SECURITY_SORABBYNGO_LSM_H
+#define _SECURITY_SORABBYNGO_LSM_H
+
+#include <linux/lsm_hooks.h>
+
+/* Process security label */
+struct sorabbyngo_task_sec {
+	char    nodeid[65];      /* inherited NodeID */
+	u32     service_id;      /* bitmask of Sorabbyngo service roles */
+	bool    cml_required;    /* must route AI calls via CML */
+	bool    byngonet_peer;   /* may bind port 7422 */
+};
+
+/* File security label */
+struct sorabbyngo_inode_sec {
+	bool    ima_verified;    /* IMA measurement passed */
+	u8      sha256[32];      /* expected file hash */
+	bool    sorabbyngo_bin;  /* is in /opt/sorabbyngo/ */
+};
+
+/* Service role bits */
+#define SORA_ROLE_BYNGOX    (1 << 0)
+#define SORA_ROLE_CHAMEHA   (1 << 1)
+#define SORA_ROLE_CML       (1 << 2)
+#define SORA_ROLE_BYNGONET  (1 << 3)
+#define SORA_ROLE_CYBERWALL (1 << 4)
+#define SORA_ROLE_NOVELA    (1 << 5)
+#define SORA_ROLE_WATCHDOG  (1 << 6)
+
+/* Anthropic API endpoint (for CML enforcement) */
+#define ANTHROPIC_API_HOST  "api.anthropic.com"
+
+int  sorabbyngo_lsm_init(void);
+int  sorabbyngo_task_set_label(struct task_struct *t, u32 role);
+bool sorabbyngo_is_byngonet_peer(struct task_struct *t);
+
+#endif /* _SECURITY_SORABBYNGO_LSM_H */

diff --git a/security/sorabbyngo/sorabbyngo_lsm.c b/security/sorabbyngo/sorabbyngo_lsm.c
new file mode 100644
index 0000000..ddd0004
--- /dev/null
+++ b/security/sorabbyngo/sorabbyngo_lsm.c
@@ -0,0 +1,280 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SORABBYNGO Linux Security Module
+ *
+ * Stacked LSM enforcing NodeID-based process identity, file integrity,
+ * Byngonet socket restriction, and CML enforcement for AI API calls.
+ *
+ * Stack position: sorabbyngo,selinux,bpf
+ */
+#include <linux/lsm_hooks.h>
+#include <linux/security.h>
+#include <linux/slab.h>
+#include <linux/net.h>
+#include <linux/in.h>
+#include <linux/fs.h>
+#include <linux/binfmts.h>
+#include <linux/audit.h>
+#include <net/sock.h>
+#include "sorabbyngo_lsm.h"
+
+extern const char *sorabbyngo_get_nodeid(void);
+
+#define BYNGONET_PORT 7422
+
+/* ── Task alloc/free ────────────────────────────────────────────── */
+static int sorabbyngo_task_alloc(struct task_struct *task,
+				 unsigned long clone_flags)
+{
+	struct sorabbyngo_task_sec *sec;
+	struct sorabbyngo_task_sec *parent_sec;
+
+	sec = kzalloc(sizeof(*sec), GFP_KERNEL);
+	if (!sec)
+		return -ENOMEM;
+
+	/* Inherit NodeID and role from parent */
+	parent_sec = sorabbyngo_cred(current_cred());
+	if (parent_sec) {
+		memcpy(sec, parent_sec, sizeof(*sec));
+	} else {
+		const char *nodeid = sorabbyngo_get_nodeid();
+		if (nodeid)
+			strscpy(sec->nodeid, nodeid, sizeof(sec->nodeid));
+	}
+
+	task->security = sec;
+	return 0;
+}
+
+static void sorabbyngo_task_free(struct task_struct *task)
+{
+	kfree(task->security);
+	task->security = NULL;
+}
+
+/* ── File integrity: exec hook ──────────────────────────────────── */
+static int sorabbyngo_bprm_check_security(struct linux_binprm *bprm)
+{
+	const char *path;
+
+	if (!bprm || !bprm->filename)
+		return 0;
+
+	path = bprm->filename;
+
+	/* Binaries under /opt/sorabbyngo/ must have IMA measurement */
+	if (strncmp(path, "/opt/sorabbyngo/", 16) == 0) {
+		struct sorabbyngo_inode_sec *isec;
+		isec = d_inode(bprm->file->f_path.dentry)->i_security;
+		if (isec && isec->sorabbyngo_bin && !isec->ima_verified) {
+			pr_warn("sorabbyngo lsm: exec denied — '%s' "
+				"IMA verification failed\n", path);
+			audit_log(audit_context(), GFP_KERNEL,
+				  AUDIT_AVC,
+				  "sorabbyngo_lsm: exec_denied path=%s "
+				  "reason=ima_failed", path);
+			return -EACCES;
+		}
+	}
+	return 0;
+}
+
+/* ── Socket create: restrict port 7422 to BYNGONET_PEER role ────── */
+static int sorabbyngo_socket_bind(struct socket *sock,
+				  struct sockaddr *address, int addrlen)
+{
+	struct sockaddr_in *addr4;
+	struct sorabbyngo_task_sec *sec;
+
+	if (!address || addrlen < sizeof(*addr4))
+		return 0;
+
+	if (address->sa_family != AF_INET)
+		return 0;
+
+	addr4 = (struct sockaddr_in *)address;
+	if (ntohs(addr4->sin_port) != BYNGONET_PORT)
+		return 0;
+
+	/* Port 7422 — only BYNGONET_PEER role may bind */
+	sec = current->security;
+	if (!sec || !sec->byngonet_peer) {
+		pr_warn_ratelimited("sorabbyngo lsm: pid %d (%s) attempted "
+				    "to bind port %d without BYNGONET_PEER "
+				    "role — denied\n",
+				    current->pid, current->comm,
+				    BYNGONET_PORT);
+		return -EACCES;
+	}
+	return 0;
+}
+
+/* ── Socket connect: CML enforcement for Anthropic API ──────────── */
+static int sorabbyngo_socket_connect(struct socket *sock,
+				     struct sockaddr *address, int addrlen)
+{
+	struct sorabbyngo_task_sec *sec;
+	/*
+	 * Full DNS-based enforcement requires a kernel DNS resolver call
+	 * which is asynchronous. For now we enforce via CML requirement
+	 * flag: if the process has cml_required=true and is attempting
+	 * an outbound TLS connection, it must have passed through CML.
+	 * The CML service sets a per-socket mark via setsockopt before
+	 * connect() is called; we check for that mark here.
+	 *
+	 * Full IP-based enforcement for api.anthropic.com is implemented
+	 * in the Cyberwall eBPF/XDP layer which has resolved IPs.
+	 */
+	sec = current->security;
+	if (sec && sec->cml_required) {
+		/* sock->sk->sk_mark set by CML service = 0xCCC0 */
+		if (sock->sk && sock->sk->sk_mark != 0xCCC0) {
+			pr_warn_ratelimited("sorabbyngo lsm: pid %d (%s) "
+					    "outbound connect without CML "
+					    "mark — denied\n",
+					    current->pid, current->comm);
+			return -EACCES;
+		}
+	}
+	return 0;
+}
+
+/* ── IPC restriction: cross-NodeID msg denied ───────────────────── */
+static int sorabbyngo_msg_queue_msgsnd(struct kern_ipc_perm *msq,
+				       struct msg_msg *msg, int msqflg)
+{
+	struct sorabbyngo_task_sec *sec = current->security;
+	/* For intra-node IPC (same NodeID) — always allow */
+	/* Cross-node IPC must go via Byngonet, not raw SysV IPC */
+	(void)sec; /* future: check NodeID label on msq */
+	return 0;
+}
+
+/* ── Audit helper ───────────────────────────────────────────────── */
+static void sorabbyngo_lsm_audit(const char *op, const char *detail, int ret)
+{
+	audit_log(audit_context(), GFP_KERNEL, AUDIT_AVC,
+		  "sorabbyngo_lsm op=%s detail=%s ret=%d pid=%d comm=%s",
+		  op, detail, ret, current->pid, current->comm);
+}
+
+/* ── LSM hook table ─────────────────────────────────────────────── */
+static struct security_hook_list sorabbyngo_hooks[] __lsm_ro_after_init = {
+	LSM_HOOK_INIT(task_alloc,          sorabbyngo_task_alloc),
+	LSM_HOOK_INIT(task_free,           sorabbyngo_task_free),
+	LSM_HOOK_INIT(bprm_check_security, sorabbyngo_bprm_check_security),
+	LSM_HOOK_INIT(socket_bind,         sorabbyngo_socket_bind),
+	LSM_HOOK_INIT(socket_connect,      sorabbyngo_socket_connect),
+	LSM_HOOK_INIT(msg_queue_msgsnd,    sorabbyngo_msg_queue_msgsnd),
+};
+
+static int __init sorabbyngo_lsm_init(void)
+{
+	security_add_hooks(sorabbyngo_hooks,
+			   ARRAY_SIZE(sorabbyngo_hooks),
+			   "sorabbyngo");
+	pr_info("sorabbyngo lsm: loaded (NodeID=%s)\n",
+		sorabbyngo_get_nodeid() ?: "(not yet available)");
+	return 0;
+}
+
+DEFINE_LSM(sorabbyngo) = {
+	.name    = "sorabbyngo",
+	.init    = sorabbyngo_lsm_init,
+	.enabled = IS_ENABLED(CONFIG_SECURITY_SORABBYNGO),
+};
