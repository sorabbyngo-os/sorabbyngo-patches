diff --git a/security/sorabbyngo/lsm.c b/security/sorabbyngo/lsm.c
index XXXXXXX..XXXXXXX 100644
--- a/security/sorabbyngo/lsm.c
+++ b/security/sorabbyngo/lsm.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
  * Sorabbyngo LSM — patch 0017 addition: canary check hook for CML path.
+ * Any buffer returned to the CML AI API layer is canary-verified first.
  */
+#include "../../mm/sorabbyngo_malloc_harden.h"

+/*
+ * sorabbyngo_lsm_cml_buf_check — verify heap canary on any buffer the
+ * CML layer is about to pass to an AI API call.  Called from the CML
+ * enforcement hook (patch 0012) before the API dispatch.
+ *
+ * This closes the gap where a UAF or overflow in the AI response parsing
+ * path could corrupt a buffer *after* NodeID verification but *before*
+ * the API call is dispatched.
+ */
+int sorabbyngo_lsm_cml_buf_check(const void *buf, size_t size)
+{
+	if (size < SORABBYNGO_HARDEN_MIN_SIZE ||
+	    size > SORABBYNGO_HARDEN_MAX_SIZE)
+		return 0; /* out of range — trust the slab guard pages */
+
+	if (!sorabbyngo_canary_check(buf, size)) {
+		sorabbyngo_audit_emit(SORABBYNGO_AUDIT_CML_BUF_CORRUPT,
+				      "buf=%px size=%zu", buf, size);
+		return -EFAULT;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sorabbyngo_lsm_cml_buf_check);

