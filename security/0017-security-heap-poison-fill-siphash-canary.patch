+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * sorabbyngo_malloc_harden.h — heap poison + canary hardening.
+ *
+ * Inspired by OpenBSD kern_malloc.c poison_mem()/poison_check()/
+ * poison_value() (lines 279, 317-324, 456, 471-472).
+ *
+ * Two-layer protection:
+ *   1. Poison fill on free, pattern-check on re-alloc (UAF write detection)
+ *   2. SipHash canary appended to each allocation (overflow detection)
+ */
+#ifndef _MM_SORABBYNGO_MALLOC_HARDEN_H
+#define _MM_SORABBYNGO_MALLOC_HARDEN_H
+
+#include <linux/types.h>
+#include <linux/siphash.h>
+
+/* Canary size — always 8 bytes (u64 SipHash output) */
+#define SORABBYNGO_CANARY_SIZE   8
+
+/*
+ * Minimum allocation size to protect.  Smaller allocations (< 16 bytes)
+ * don't have room for a canary suffix without changing the size class.
+ */
+#define SORABBYNGO_HARDEN_MIN_SIZE   16
+
+/*
+ * Maximum allocation size to protect.  Above 4096 bytes we rely on
+ * the slab guard pages (patch 0004) and page-level W^X (patch 0001).
+ */
+#define SORABBYNGO_HARDEN_MAX_SIZE   4096
+
+/* Public API */
+int  sorabbyngo_malloc_harden_init(void);
+void sorabbyngo_malloc_harden_exit(void);
+
+/* Called from slab alloc/free notifiers */
+void sorabbyngo_on_alloc(void *ptr, size_t size);
+void sorabbyngo_on_free(void *ptr, size_t size);
+
+/* Direct use by LSM audit path */
+bool sorabbyngo_canary_check(const void *ptr, size_t size);
+
+#endif /* _MM_SORABBYNGO_MALLOC_HARDEN_H */

diff --git a/mm/sorabbyngo_malloc_harden.c b/mm/sorabbyngo_malloc_harden.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/mm/sorabbyngo_malloc_harden.c
@@ -0,0 +1,220 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * sorabbyngo_malloc_harden.c — heap poison fill + SipHash canary.
+ *
+ * Ported from OpenBSD sys/kern/kern_malloc.c poison machinery.
+ * OpenBSD reference lines (checked-out source):
+ *   279  : poison_mem(cp, allocsize)          — fill on alloc from freelist
+ *   317  : poison_mem(freep, sizeof(*freep))  — fill on free
+ *   324  : poison_check(va, allocsize, ...)   — check before alloc
+ *   456  : kf_spare0 == poison_value(freep)   — canary check on free
+ *   471  : poison_mem(addr, size)             — fill freed memory
+ *   472  : kf_spare0 = poison_value(freep)    — store canary
+ *
+ * Linux adaptation:
+ *   - slab_pre_alloc_hook / slab_post_free_hook via kmem_cache notifiers
+ *   - poison_value(): SipHash(ptr, nodeid_raw, boot_key) — not static
+ *   - canary stored at (ptr + ksize(ptr) - SORABBYNGO_CANARY_SIZE)
+ *   - UAF/overflow detected → BUG() + sorabbyngo_audit_emit()
+ */
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/siphash.h>
+#include <linux/random.h>
+#include <linux/bug.h>
+#include <linux/printk.h>
+#include <linux/sorabbyngo_nodeid.h>
+#include <linux/sorabbyngo_audit.h>
+#include "sorabbyngo_malloc_harden.h"
+
+/* Boot-time random key for canary SipHash — initialised once in _init() */
+static siphash_key_t sorabbyngo_harden_key __ro_after_init;
+static bool sorabbyngo_harden_ready __ro_after_init;
+
+/* ------------------------------------------------------------------ */
+/* poison_value() — OpenBSD: uintptr_t-derived pattern per object.    */
+/* We upgrade to SipHash(ptr, nodeid, boot_key) for non-static output. */
+/* ------------------------------------------------------------------ */
+
+static u64 sorabbyngo_poison_value(const void *ptr)
+{
+	u8 nodeid_raw[NODEID_RAW_LEN];
+	struct {
+		u64 addr;
+		u8  nodeid[NODEID_RAW_LEN];
+	} __packed data;

+	nodeid_get_raw(nodeid_raw, sizeof(nodeid_raw));
+	data.addr = (u64)(uintptr_t)ptr;
+	memcpy(data.nodeid, nodeid_raw, NODEID_RAW_LEN);
+	return siphash(&data, sizeof(data), &sorabbyngo_harden_key);
+}
+
+/* ------------------------------------------------------------------ */
+/* poison_mem() — fill freed region.                                   */
+/* OpenBSD fills with a repeated poison_value() byte pattern.          */
+/* We fill 8-byte words with the full SipHash value for denser coverage.*/
+/* ------------------------------------------------------------------ */
+
+static void sorabbyngo_poison_fill(void *ptr, size_t size)
+{
+	u64  pv = sorabbyngo_poison_value(ptr);
+	u64 *p  = (u64 *)ptr;
+	size_t  words = size / sizeof(u64);
+	size_t  i;
+
+	for (i = 0; i < words; i++)
+		p[i] = pv;
+
+	/* Tail bytes (if size not 8-aligned) */
+	if (size & 7) {
+		u8 *tail = (u8 *)(p + words);
+		u8 *pv8  = (u8 *)&pv;
+		size_t   j;
+		for (j = 0; j < (size & 7); j++)
+			tail[j] = pv8[j];
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* poison_check() — verify fill pattern before re-alloc.              */
+/* Returns true if pattern intact, false on corruption (UAF write).    */
+/* ------------------------------------------------------------------ */
+
+static bool sorabbyngo_poison_check(const void *ptr, size_t size,
+				     size_t *bad_idx, u64 *bad_val)
+{
+	u64  pv     = sorabbyngo_poison_value(ptr);
+	const u64 *p = (const u64 *)ptr;
+	size_t words = size / sizeof(u64);
+	size_t i;
+
+	for (i = 0; i < words; i++) {
+		if (p[i] != pv) {
+			if (bad_idx) *bad_idx = i * sizeof(u64);
+			if (bad_val) *bad_val = p[i];
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ------------------------------------------------------------------ */
+/* Canary: SipHash stored at end of allocation.                        */
+/* OpenBSD: kf_spare0 = poison_value(freep) / kf_spare0 check.        */
+/* ------------------------------------------------------------------ */
+
+static void sorabbyngo_canary_write(void *ptr, size_t size)
+{
+	u64 *canary_slot = (u64 *)((u8 *)ptr + size - SORABBYNGO_CANARY_SIZE);
+	*canary_slot = sorabbyngo_poison_value(ptr);
+}
+
+bool sorabbyngo_canary_check(const void *ptr, size_t size)
+{
+	const u64 *canary_slot =
+		(const u64 *)((const u8 *)ptr + size - SORABBYNGO_CANARY_SIZE);
+	return *canary_slot == sorabbyngo_poison_value(ptr);
+}
+EXPORT_SYMBOL_GPL(sorabbyngo_canary_check);
+
+/* ------------------------------------------------------------------ */
+/* Hook: called after kmalloc returns a pointer.                        */
+/* Writes the canary suffix; if slot was previously freed, we already  */
+/* checked poison in sorabbyngo_on_free.                               */
+/* ------------------------------------------------------------------ */
+
+void sorabbyngo_on_alloc(void *ptr, size_t size)
+{
+	size_t bad_idx;
+	u64    bad_val;
+
+	if (!sorabbyngo_harden_ready || !ptr)
+		return;
+	if (size < SORABBYNGO_HARDEN_MIN_SIZE ||
+	    size > SORABBYNGO_HARDEN_MAX_SIZE)
+		return;
+
+	/*
+	 * Check poison pattern — if this slot was previously freed by us,
+	 * the pattern should be intact.  Corruption means UAF write.
+	 * OpenBSD: poison_check(va, allocsize, &pidx, &pval) at line 324.
+	 */
+	if (!sorabbyngo_poison_check(ptr, size - SORABBYNGO_CANARY_SIZE,
+				     &bad_idx, &bad_val)) {
+		sorabbyngo_audit_emit(SORABBYNGO_AUDIT_HEAP_UAF,
+				      "ptr=%px size=%zu bad_off=%zu bad_val=0x%llx",
+				      ptr, size, bad_idx, bad_val);
+		pr_err("sorabbyngo: UAF write detected at %px+%zu "
+		       "(expected poison, got 0x%llx)\n",
+		       ptr, bad_idx, bad_val);
+		BUG();
+	}
+
+	/* Write fresh canary for this allocation lifetime */
+	sorabbyngo_canary_write(ptr, size);
+}
+EXPORT_SYMBOL_GPL(sorabbyngo_on_alloc);
+
+/* ------------------------------------------------------------------ */
+/* Hook: called before kfree releases a pointer.                        */
+/* Check canary (overflow detection), then poison fill the region.     */
+/* ------------------------------------------------------------------ */
+
+void sorabbyngo_on_free(void *ptr, size_t size)
+{
+	if (!sorabbyngo_harden_ready || !ptr)
+		return;
+	if (size < SORABBYNGO_HARDEN_MIN_SIZE ||
+	    size > SORABBYNGO_HARDEN_MAX_SIZE)
+		return;
+
+	/*
+	 * Check canary — corruption means heap overflow wrote past object.
+	 * OpenBSD: kf_spare0 == poison_value(freep) check at line 456.
+	 */
+	if (!sorabbyngo_canary_check(ptr, size)) {
+		u64 *slot = (u64 *)((u8 *)ptr + size - SORABBYNGO_CANARY_SIZE);
+		sorabbyngo_audit_emit(SORABBYNGO_AUDIT_HEAP_OVERFLOW,
+				      "ptr=%px size=%zu canary_got=0x%llx "
+				      "canary_want=0x%llx",
+				      ptr, size, *slot,
+				      sorabbyngo_poison_value(ptr));
+		pr_err("sorabbyngo: heap overflow canary corrupted at "
+		       "%px (size=%zu)\n", ptr, size);
+		BUG();
+	}
+
+	/*
+	 * Poison fill — any subsequent read of this region will get the
+	 * pattern; a write will corrupt it, detected on next re-alloc.
+	 * OpenBSD: poison_mem(addr, size) at lines 317, 471.
+	 */
+	sorabbyngo_poison_fill(ptr, size);
+}
+EXPORT_SYMBOL_GPL(sorabbyngo_on_free);
+
+/* ------------------------------------------------------------------ */
+/* Module init/exit                                                     */
+/* ------------------------------------------------------------------ */
+
+int __init sorabbyngo_malloc_harden_init(void)
+{
+	get_random_bytes(&sorabbyngo_harden_key, sizeof(sorabbyngo_harden_key));
+	/*
+	 * Mark ready only after key is fully initialised.
+	 * __ro_after_init means this is frozen once init completes.
+	 */
+	sorabbyngo_harden_ready = true;
+	pr_info("sorabbyngo: heap hardening active "
+		"(poison fill + SipHash canary, "
+		"range %d-%d bytes)\n",
+		SORABBYNGO_HARDEN_MIN_SIZE,
+		SORABBYNGO_HARDEN_MAX_SIZE);
+	return 0;
+}

+void sorabbyngo_malloc_harden_exit(void)
+{
+	sorabbyngo_harden_ready = false;
+	memzero_explicit(&sorabbyngo_harden_key, sizeof(sorabbyngo_harden_key));
+}

