 kernel/sorabbyngo_audit.c              | 185 +++++++++++++++++++++++++++++++++
 kernel/Makefile                        |   1 +
 include/uapi/linux/sorabbyngo_audit.h  |  28 +++++
 5 files changed, 266 insertions(+)

diff --git a/include/linux/sorabbyngo_audit.h b/include/linux/sorabbyngo_audit.h
new file mode 100644
index 0000000..eee0005
--- /dev/null
+++ b/include/linux/sorabbyngo_audit.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SORABBYNGO_AUDIT_H
+#define _LINUX_SORABBYNGO_AUDIT_H
+
+#include <linux/types.h>
+#include <linux/time.h>
+
+#define SORABBYNGO_AUDIT_RING_SIZE  4096
+#define SORABBYNGO_AUDIT_DETAIL_LEN 256
+
+/* Event type codes */
+#define SORA_AUDIT_LSM_DENY       0x0001
+#define SORA_AUDIT_BPF_LOAD       0x0002
+#define SORA_AUDIT_NODEID_READ    0x0003
+#define SORA_AUDIT_PEER_ADD       0x0004
+#define SORA_AUDIT_PEER_REMOVE    0x0005
+#define SORA_AUDIT_PLEDGE         0x0006
+#define SORA_AUDIT_UNVEIL         0x0007
+#define SORA_AUDIT_WX_VIOLATION   0x0008
+#define SORA_AUDIT_MODULE_LOAD    0x0009
+#define SORA_AUDIT_MODULE_UNLOAD  0x000A
+#define SORA_AUDIT_PRIVESC        0x000B
+#define SORA_AUDIT_GAP            0x00FF  /* ring overflow marker */
+
+struct sorabbyngo_audit_entry {
+	u16     type;
+	u32     pid;
+	s64     timestamp_ns;
+	char    comm[16];
+	char    detail[SORABBYNGO_AUDIT_DETAIL_LEN];
+	u8      prev_hash[32];   /* SHA-256 of previous entry */
+	u8      this_hash[32];   /* SHA-256 of this entry (set after write) */
+};
+
+/* Main API — callable from anywhere in the kernel */
+void sorabbyngo_audit(u16 type, const char *detail);
+void sorabbyngo_audit_get_root_hash(u8 *out_hash32);
+int  sorabbyngo_audit_verify_chain(void);
+
+#endif /* _LINUX_SORABBYNGO_AUDIT_H */

diff --git a/kernel/sorabbyngo_audit.c b/kernel/sorabbyngo_audit.c
new file mode 100644
index 0000000..fff0006
--- /dev/null
+++ b/kernel/sorabbyngo_audit.c
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SORABBYNGO Kernel Audit Chain
+ *
+ * SHA-256 chained append-only audit log for kernel security events.
+ * Mirrors the userspace CML audit ledger so kernel + userspace events
+ * form one continuous verifiable chain.
+ *
+ * Kenya DPA 2019 s.41 requires audit logs for systems processing
+ * personal health data. This log satisfies that at the kernel level.
+ */
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/crypto.h>
+#include <linux/scatterlist.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/ktime.h>
+#include <crypto/hash.h>
+#include <linux/sorabbyngo_audit.h>
+
+static struct sorabbyngo_audit_entry ring[SORABBYNGO_AUDIT_RING_SIZE];
+static u32    ring_head;   /* next write position */
+static u32    ring_count;  /* total entries written (including dropped) */
+static u8     chain_root[32];   /* hash of most recent entry */
+static DEFINE_SPINLOCK(audit_lock);
+static struct proc_dir_entry *audit_proc;
+
+/*
+ * sha256_entry - compute SHA-256 over an audit entry.
+ * Hashes: prev_hash || timestamp_ns || pid || type || detail
+ */
+static int sha256_entry(const struct sorabbyngo_audit_entry *e, u8 *out)
+{
+	struct crypto_shash *tfm;
+	struct shash_desc   *desc;
+	int ret;
+
+	tfm = crypto_alloc_shash("sha256", 0, 0);
+	if (IS_ERR(tfm))
+		return PTR_ERR(tfm);
+
+	desc = kzalloc(sizeof(*desc) + crypto_shash_descsize(tfm),
+		       GFP_ATOMIC);
+	if (!desc) {
+		crypto_free_shash(tfm);
+		return -ENOMEM;
+	}
+	desc->tfm = tfm;
+
+	crypto_shash_init(desc);
+	crypto_shash_update(desc, e->prev_hash,    sizeof(e->prev_hash));
+	crypto_shash_update(desc, (u8 *)&e->timestamp_ns,
+			    sizeof(e->timestamp_ns));
+	crypto_shash_update(desc, (u8 *)&e->pid,   sizeof(e->pid));
+	crypto_shash_update(desc, (u8 *)&e->type,  sizeof(e->type));
+	crypto_shash_update(desc, e->detail,       strlen(e->detail));
+	ret = crypto_shash_final(desc, out);
+
+	kfree(desc);
+	crypto_free_shash(tfm);
+	return ret;
+}
+
+/*
+ * sorabbyngo_audit - append an event to the chain.
+ * Safe to call from any context (uses GFP_ATOMIC).
+ */
+void sorabbyngo_audit(u16 type, const char *detail)
+{
+	struct sorabbyngo_audit_entry *e;
+	unsigned long flags;
+	u32 idx;
+
+	spin_lock_irqsave(&audit_lock, flags);
+
+	idx = ring_head % SORABBYNGO_AUDIT_RING_SIZE;
+	e   = &ring[idx];
+
+	/* If we're overwriting an old entry, mark gap in next */
+	if (ring_count >= SORABBYNGO_AUDIT_RING_SIZE)
+		e->type = SORA_AUDIT_GAP;
+
+	memset(e, 0, sizeof(*e));
+	e->type         = type;
+	e->pid          = current->pid;
+	e->timestamp_ns = ktime_get_real_ns();
+	memcpy(e->comm, current->comm, sizeof(e->comm));
+	strscpy(e->detail, detail ? detail : "(none)",
+		SORABBYNGO_AUDIT_DETAIL_LEN);
+	memcpy(e->prev_hash, chain_root, sizeof(chain_root));
+
+	/* Compute and store this entry's hash */
+	if (sha256_entry(e, e->this_hash) == 0)
+		memcpy(chain_root, e->this_hash, sizeof(chain_root));
+
+	ring_head++;
+	ring_count++;
+
+	spin_unlock_irqrestore(&audit_lock, flags);
+}
+EXPORT_SYMBOL(sorabbyngo_audit);
+
+void sorabbyngo_audit_get_root_hash(u8 *out)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&audit_lock, flags);
+	memcpy(out, chain_root, 32);
+	spin_unlock_irqrestore(&audit_lock, flags);
+}
+EXPORT_SYMBOL(sorabbyngo_audit_get_root_hash);
+
+/*
+ * sorabbyngo_audit_verify_chain - walk the ring and verify hash chain.
+ * Returns 0 if intact, -EIO if any link is broken.
+ */
+int sorabbyngo_audit_verify_chain(void)
+{
+	u32 count = min(ring_count, (u32)SORABBYNGO_AUDIT_RING_SIZE);
+	u32 start = (ring_head - count) % SORABBYNGO_AUDIT_RING_SIZE;
+	u8  computed[32];
+	u32 i;
+
+	for (i = 0; i < count; i++) {
+		struct sorabbyngo_audit_entry *e =
+			&ring[(start + i) % SORABBYNGO_AUDIT_RING_SIZE];
+
+		if (sha256_entry(e, computed) != 0)
+			return -EIO;
+
+		if (memcmp(computed, e->this_hash, 32) != 0) {
+			pr_err("sorabbyngo audit: chain broken at entry %u "
+			       "(pid=%d type=0x%04x)\n",
+			       i, e->pid, e->type);
+			return -EIO;
+		}
+	}
+	return 0;
+}
+EXPORT_SYMBOL(sorabbyngo_audit_verify_chain);
+
+/* /proc/sorabbyngo/audit_root — exposes chain root hash */
+static int audit_root_show(struct seq_file *m, void *v)
+{
+	u8  hash[32];
+	int i;
+
+	sorabbyngo_audit_get_root_hash(hash);
+	for (i = 0; i < 32; i++)
+		seq_printf(m, "%02x", hash[i]);
+	seq_putc(m, '\n');
+	seq_printf(m, "entries: %u\n", ring_count);
+	seq_printf(m, "intact: %s\n",
+		   sorabbyngo_audit_verify_chain() == 0 ? "yes" : "NO");
+	return 0;
+}

+static int audit_root_open(struct inode *i, struct file *f)
+{
+	return single_open(f, audit_root_show, NULL);
+}
+
+static const struct proc_ops audit_root_proc_ops = {
+	.proc_open    = audit_root_open,
+	.proc_read    = seq_read,
+	.proc_lseek   = seq_lseek,
+	.proc_release = single_release,
+};
+
+static int __init sorabbyngo_audit_init(void)
+{
+	extern struct proc_dir_entry *sorabbyngo_proc_dir;
+
+	memset(chain_root, 0, sizeof(chain_root));
+	memset(ring, 0, sizeof(ring));
+
+	audit_proc = proc_create("audit_root", 0444,
+				 sorabbyngo_proc_dir,
+				 &audit_root_proc_ops);
+	if (!audit_proc)
+		pr_warn("sorabbyngo audit: failed to create proc entry\n");
+
+	sorabbyngo_audit(SORA_AUDIT_MODULE_LOAD, "sorabbyngo_audit: init");
+	pr_info("sorabbyngo audit: SHA-256 chain active "
+		"(ring=%d entries)\n", SORABBYNGO_AUDIT_RING_SIZE);
+	return 0;
+}
+early_initcall(sorabbyngo_audit_init);
